$PBExportHeader$d_cliente_detalhe.srd
$PBExportComments$Formulário (freeform) de cadastro de cliente - atualiza dbo.cliente
release 22;
datawindow(units=0 timer_interval=0 color=67108864 processing=0 print.documentname="" print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.source=0 print.paper.size=0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=0 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=1100 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_cliente dbname="cliente.id_cliente" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tipo_pessoa dbname="cliente.tipo_pessoa" initial="F" values="Física	F/Jurídica	J/" )
 column=(type=char(100) update=yes updatewhereclause=yes name=nome dbname="cliente.nome" )
 column=(type=char(100) update=yes updatewhereclause=yes name=nome_fantasia dbname="cliente.nome_fantasia" )
 column=(type=char(14) update=yes updatewhereclause=yes name=cpf_cnpj dbname="cliente.cpf_cnpj" )
 column=(type=char(20) update=yes updatewhereclause=yes name=rg_ie dbname="cliente.rg_ie" )
 column=(type=date update=yes updatewhereclause=yes name=data_nascimento dbname="cliente.data_nascimento" )
 column=(type=char(120) update=yes updatewhereclause=yes name=email dbname="cliente.email" )
 column=(type=char(15) update=yes updatewhereclause=yes name=telefone dbname="cliente.telefone" )
 column=(type=char(15) update=yes updatewhereclause=yes name=celular dbname="cliente.celular" )
 column=(type=char(8) update=yes updatewhereclause=yes name=cep dbname="cliente.cep" )
 column=(type=char(100) update=yes updatewhereclause=yes name=logradouro dbname="cliente.logradouro" )
 column=(type=char(10) update=yes updatewhereclause=yes name=numero dbname="cliente.numero" )
 column=(type=char(50) update=yes updatewhereclause=yes name=complemento dbname="cliente.complemento" )
 column=(type=char(60) update=yes updatewhereclause=yes name=bairro dbname="cliente.bairro" )
 column=(type=char(60) update=yes updatewhereclause=yes name=cidade dbname="cliente.cidade" )
 column=(type=char(2) update=yes updatewhereclause=yes name=uf dbname="cliente.uf" values="AC	AC/AL	AL/AM	AM/AP	AP/BA	BA/CE	CE/DF	DF/ES	ES/GO	GO/MA	MA/MG	MG/MS	MS/MT	MT/PA	PA/PB	PB/PE	PE/PI	PI/PR	PR/RJ	RJ/RN	RN/RO	RO/RR	RR/RS	RS/SC	SC/SE	SE/SP	SP/TO	TO/" )
 column=(type=char(500) update=yes updatewhereclause=yes name=observacao dbname="cliente.observacao" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ativo dbname="cliente.ativo" initial="S" )
 column=(type=datetime updatewhereclause=yes name=data_cadastro dbname="cliente.data_cadastro" )
 column=(type=datetime update=yes updatewhereclause=yes name=data_alteracao dbname="cliente.data_alteracao" )
 retrieve="SELECT cliente.id_cliente, cliente.tipo_pessoa, cliente.nome, cliente.nome_fantasia, cliente.cpf_cnpj, cliente.rg_ie, cliente.data_nascimento, cliente.email, cliente.telefone, cliente.celular, cliente.cep, cliente.logradouro, cliente.numero, cliente.complemento, cliente.bairro, cliente.cidade, cliente.uf, cliente.observacao, cliente.ativo, cliente.data_cadastro, cliente.data_alteracao~r~n  FROM cliente~r~n WHERE cliente.id_cliente = :al_id_cliente" update="cliente" updatewhere=0 updatekeyinplace=no arguments=(("al_id_cliente", number)) )
