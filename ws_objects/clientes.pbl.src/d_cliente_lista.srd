table(column=(type=long updatewhereclause=yes name=id_cliente dbname="cliente.id_cliente" )
 column=(type=char(1) updatewhereclause=yes name=tipo_pessoa dbname="cliente.tipo_pessoa" )
 column=(type=char(100) updatewhereclause=yes name=nome dbname="cliente.nome" )
 column=(type=char(14) updatewhereclause=yes name=cpf_cnpj dbname="cliente.cpf_cnpj" )
 column=(type=char(15) updatewhereclause=yes name=telefone dbname="cliente.telefone" )
 column=(type=char(15) updatewhereclause=yes name=celular dbname="cliente.celular" )
 column=(type=char(60) updatewhereclause=yes name=cidade dbname="cliente.cidade" )
 column=(type=char(2) updatewhereclause=yes name=uf dbname="cliente.uf" )
 column=(type=char(1) updatewhereclause=yes name=ativo dbname="cliente.ativo" values="	S/	N" )
 retrieve="SELECT cliente.id_cliente, cliente.tipo_pessoa, cliente.nome, cliente.cpf_cnpj, cliente.telefone, cliente.celular, cliente.cidade, cliente.uf, cliente.ativo
  FROM cliente
 WHERE (cliente.ativo = 'S' OR :as_inativos = 'S')
   AND (ISNULL(:as_filtro, '') = ''
        OR cliente.nome LIKE '%' + :as_filtro + '%'
        OR cliente.cpf_cnpj LIKE :as_filtro + '%'
        OR cliente.cidade LIKE '%' + :as_filtro + '%')
 ORDER BY cliente.nome" arguments=(("as_filtro", string),("as_inativos", string)) )
