$PBExportHeader$d_cliente_lista.srd
$PBExportComments$Lista (grid) de clientes com filtro por nome, CPF/CNPJ ou cidade
release 22;
datawindow(units=0 timer_interval=0 color=1073741824 processing=1 print.documentname="" print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=96 print.margin.bottom=96 print.paper.source=0 print.paper.size=0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=84 color="67108864" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=id_cliente dbname="cliente.id_cliente" )
 column=(type=char(1) updatewhereclause=yes name=tipo_pessoa dbname="cliente.tipo_pessoa" )
 column=(type=char(100) updatewhereclause=yes name=nome dbname="cliente.nome" )
 column=(type=char(14) updatewhereclause=yes name=cpf_cnpj dbname="cliente.cpf_cnpj" )
 column=(type=char(15) updatewhereclause=yes name=telefone dbname="cliente.telefone" )
 column=(type=char(15) updatewhereclause=yes name=celular dbname="cliente.celular" )
 column=(type=char(60) updatewhereclause=yes name=cidade dbname="cliente.cidade" )
 column=(type=char(2) updatewhereclause=yes name=uf dbname="cliente.uf" )
 column=(type=char(1) updatewhereclause=yes name=ativo dbname="cliente.ativo" )
 retrieve="SELECT cliente.id_cliente, cliente.tipo_pessoa, cliente.nome, cliente.cpf_cnpj, cliente.telefone, cliente.celular, cliente.cidade, cliente.uf, cliente.ativo~r~n  FROM cliente~r~n WHERE (cliente.ativo = 'S' OR :as_inativos = 'S')~r~n   AND (ISNULL(:as_filtro, '') = ''~r~n        OR cliente.nome LIKE '%' + :as_filtro + '%'~r~n        OR cliente.cpf_cnpj LIKE :as_filtro + '%'~r~n        OR cliente.cidade LIKE '%' + :as_filtro + '%')~r~n ORDER BY cliente.nome" arguments=(("as_filtro", string),("as_inativos", string)) )
text(band=header alignment="2" text="Código" border="0" color="33554432" x="9" y="8" height="64" width="230" name=id_cliente_t visible="1" font.face="Tahoma" font.height="-10" font.weight="700" font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
